Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Etalase internasional imagine.kitlab.id: folder, kode, dan database yang SAMA dengan ResepFoto.
# Halaman utama & manifest lewat site.php (English saja). Landing /promo masih berbahasa Indonesia,
# jadi dialihkan ke beranda etalasenya sampai versi English/Thai-nya ada.
RewriteCond %{HTTP_HOST} ^imagine\. [NC]
RewriteRule ^(th/)?promo(-live)?(/.*)?$ /$1 [R=302,L]
# Etalase Thailand imagine.kitlab.id/th/ (Thai bawaan + English): halaman utama & manifest lewat site.php?s=th.
# Semua file lain di bawah /th/ (api.php, img/, uploads/, …) dilayani dari folder utama, jadi alamat relatif
# di index.html tetap jalan tanpa <base> (yang akan merusak ikon <use href="#…">).
RewriteCond %{HTTP_HOST} ^imagine\. [NC]
RewriteRule ^th$ /th/ [R=301,L]
RewriteCond %{HTTP_HOST} ^imagine\. [NC]
RewriteRule ^th/(index\.html)?$ site.php?s=th [L,QSA]
RewriteCond %{HTTP_HOST} ^imagine\. [NC]
RewriteRule ^th/site\.webmanifest$ site.php?s=th&f=manifest [L]
RewriteCond %{HTTP_HOST} ^imagine\. [NC]
RewriteRule ^th/(.+)$ $1 [L]
RewriteCond %{HTTP_HOST} ^imagine\. [NC]
RewriteRule ^(index\.html)?$ site.php [L]
RewriteCond %{HTTP_HOST} ^imagine\. [NC]
RewriteRule ^site\.webmanifest$ site.php?f=manifest [L]
</IfModule>

<FilesMatch "^(config\.php|config\.example\.php|lib\.php|ai\.php|xlsx\.php|php\.ini|\.user\.ini|\.autodeploy|.*\.(sqlite|sqlite-wal|sqlite-shm|json|part|md|log|zip|sql|bak|tar|gz))$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # HTML shell selalu dicek ulang ke server (JS/CSS inline atau ber-versi ?v=), supaya update langsung terlihat
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
  </FilesMatch>
  <FilesMatch "\.js$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
  AddType image/x-icon .ico
</IfModule>
